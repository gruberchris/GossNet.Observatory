<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!--
          MSTest 4 runs on Microsoft.Testing.Platform, so the test assembly is a
          self-hosting executable. global.json points `dotnet test` at that runner.
        -->
        <EnableMSTestRunner>true</EnableMSTestRunner>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MSTest" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\GossNet.Observatory\GossNet.Observatory.csproj" />
    </ItemGroup>

</Project>
