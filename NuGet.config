<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <!-- Temporary: see the note in Directory.Packages.props. -->
        <add key="local" value="./local-packages" />
    </packageSources>
    <!--
      Central Package Management requires explicit source mapping once more than one
      source is configured (NU1507). Only GossNet.* may come from the local folder feed.
    -->
    <packageSourceMapping>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
        <packageSource key="local">
            <package pattern="GossNet.*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
